  "recipe": {
    "name": "Crispy Duck Breast and Leg with Cherries",
    "time": "2 hr 30 min",
    "course": "mains",
    "rating": 0,
    "serves": "4",
    "source": "scraped",
    "cuisine": "GB",
    "glass": null,
