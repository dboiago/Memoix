  "recipe": {
    "name": "Chocolate Delice, Namelaka, Butternut Squash and Milk Sorbet",
    "time": "4 hr 30 min",
    "course": "desserts",
    "rating": 0,
    "serves": "6",
    "source": "scraped",
    "cuisine": "GB",
    "glass": null,
    "garnish": [],
