  "recipe": {
    "name": "Dal Maharani (शाही दाल महारानी / मिक्स दाल तड़का / शादी वाली दाल)",
    "time": "50 min",
    "course": "sides",
    "rating": 0,
    "serves": "2",
    "source": "scraped",
    "cuisine": "IN",
    "glass": null,
