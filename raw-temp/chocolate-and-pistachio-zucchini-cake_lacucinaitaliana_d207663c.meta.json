  "ldIngredientsRaw": [
    "1/2LB. zucchini, trimmed",
    "1 1/4CUPS all-purpose flour",
    "3/4CUP sugar",
    "1/3CUP almond milk",
    "4TBSP. chocolate chips",
    "1/2CUP shelled pistachios",
    "1/3CUP wheat starch",
    "2/3CUP unsweetened cocoa powder",
    "1/4CUP peanut oil",
    "1TBSP. Acacia honey",
    "1PACKET vanilla baking powder (Vanillina)",
    "unsalted butter",
    "salt"
  ],
  "ldInstructionsRaw": [
    "<p>Preheat the oven to 350°F.&nbsp;</p>",
    "<p>Grate the zucchini into thin strips. In a food processor, blend the pistachios with the oil and the almond milk. Mix in the honey, sugar, and a pinch of salt; add in the zucchini and pulse.</p>",
    "<p>Sift the flour, wheat starch, vanilla baking powder and cocoa powder together and add to the zucchini mixture. Blend to combine.</p>",
    "<p>Butter and flour a bundt pan (7 1/2\" diameter) and pour in the batter; top with the chocolate chips and bake for 50-55 minutes. Serve the cake cold.</p>"
  ],
