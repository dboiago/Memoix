    "1 gallon warm water",
    "5 tablespoons Morton Coarse Kosher Salt",
    "2/3 cup packed light brown sugar",
    "1  large onion (sliced)",
    "1 bunch fresh thyme",
    "1 bunch fresh parsley",
    "1 tablespoon black peppercorns",
    "1  dried bay leaf"
